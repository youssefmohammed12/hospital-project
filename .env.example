# HealthBridge Environment Configuration

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=healthbridge
DB_USER=root
DB_PASS=

# Application Environment (development, production)
APP_ENV=development
APP_DEBUG=true

# Canonical origin used in password-reset and future account emails.
# Set the public HTTPS origin before enabling mail on a hosted environment.
APP_BASE_URL=http://127.0.0.1/optimized

# Hosted/non-Windows runtimes may use the hosting platform's protected
# environment-secret settings instead of local Windows DPAPI storage.
# Do not place a real app password in this sample file or commit it.
# SMTP_USER=your-sender@example.com
# SMTP_PASS=
