<?php
/**
 * Test script for the booking regression fix.
 * Tests all three booking flows against the book_appointment.php logic.
 */

require_once __DIR__ . '/php/config.php';

echo "=== BOOKING REGRESSION FIX TEST ===\n\n";

try {
    $db = getDB();
    
    // 1. Check departments
    echo "--- Departments in DB ---\n";
    $stmt = $db->query('SELECT id, name, status FROM departments');
    $departments = $stmt->fetchAll();
    foreach ($departments as $d) {
        echo "  ID: {$d['id']}, Name: {$d['name']}, Status: {$d['status']}\n";
    }
    
    // Find Dermatology
    $dermDept = null;
    foreach ($departments as $d) {
        if ($d['name'] === 'Dermatology') {
            $dermDept = $d;
            break;
        }
    }
    if (!$dermDept) {
        echo "\nWARNING: Dermatology department not found! Using first active department.\n";
        foreach ($departments as $d) {
            if ($d['status'] === 'active') {
                $dermDept = $d;
                break;
            }
        }
    }
    echo "\nUsing department: ID={$dermDept['id']}, Name={$dermDept['name']}\n";
    
    // 2. Check Dr. Sarah Johnson
    echo "\n--- Doctor Lookup ---\n";
    $stmt = $db->prepare("SELECT id, name, role FROM users WHERE name = ? AND role = 'doctor'");
    $stmt->execute(['Dr. Sarah Johnson']);
    $doc = $stmt->fetch();
    echo $doc ? "  Found: ID={$doc['id']}, Name={$doc['name']}\n" : "  NOT FOUND: Dr. Sarah Johnson\n";
    
    // 3. Check Ahmed Hassan
    echo "\n--- Patient Lookup ---\n";
    $stmt = $db->prepare("SELECT id, name, role FROM users WHERE name = ? AND role = 'patient'");
    $stmt->execute(['Ahmed Hassan']);
    $pat = $stmt->fetch();
    echo $pat ? "  Found: ID={$pat['id']}, Name={$pat['name']}\n" : "  NOT FOUND: Ahmed Hassan\n";
    
    // 4. Test the department resolution logic
    echo "\n\n=== TESTING DEPARTMENT RESOLUTION LOGIC ===\n\n";
    
    // Test 1: Only department name (legacy patient booking flow)
    echo "Test 1: Only department name provided (dashboard.js flow)\n";
    $deptStmt = $db->prepare("SELECT id, name, status FROM departments WHERE name = ? LIMIT 1");
    $deptStmt->execute([$dermDept['name']]);
    $row = $deptStmt->fetch();
    if ($row) {
        echo "  PASS: Resolved '{$row['name']}' -> ID={$row['id']}, Status={$row['status']}\n";
    } else {
        echo "  FAIL: Could not resolve department name\n";
    }
    
    // Test 2: Only department_id (admin/EMR flow)
    echo "\nTest 2: Only department_id provided (admin.js, patient-emr.js flow)\n";
    $deptStmt = $db->prepare("SELECT id, name, status FROM departments WHERE id = ? LIMIT 1");
    $deptStmt->execute([$dermDept['id']]);
    $row = $deptStmt->fetch();
    if ($row) {
        echo "  PASS: Resolved ID={$row['id']} -> '{$row['name']}', Status={$row['status']}\n";
    } else {
        echo "  FAIL: Could not resolve department ID\n";
    }
    
    // Test 3: Both department_id and department name (matching)
    echo "\nTest 3: Both department_id and department name provided (matching)\n";
    $deptStmt = $db->prepare("SELECT id, name, status FROM departments WHERE id = ? AND name = ? LIMIT 1");
    $deptStmt->execute([$dermDept['id'], $dermDept['name']]);
    $row = $deptStmt->fetch();
    if ($row) {
        echo "  PASS: ID={$row['id']} and name='{$row['name']}' match\n";
    } else {
        echo "  FAIL: ID and name do not match\n";
    }
    
    // Test 4: Both department_id and department name (mismatch)
    echo "\nTest 4: Both department_id and department name provided (MISMATCH - should fail)\n";
    $deptStmt = $db->prepare("SELECT id, name, status FROM departments WHERE id = ? AND name = ? LIMIT 1");
    $deptStmt->execute([$dermDept['id'], 'Cardiology']);
    $row = $deptStmt->fetch();
    if (!$row) {
        echo "  PASS: Correctly rejected mismatch (ID={$dermDept['id']} with name='Cardiology')\n";
    } else {
        echo "  FAIL: Should have rejected mismatch\n";
    }
    
    // Test 5: Inactive department
    echo "\nTest 5: Inactive department check\n";
    $deptStmt = $db->prepare("SELECT id, name, status FROM departments WHERE id = ? LIMIT 1");
    $deptStmt->execute([$dermDept['id']]);
    $row = $deptStmt->fetch();
    if ($row['status'] === 'active') {
        echo "  PASS: Department '{$row['name']}' is active\n";
    } else {
        echo "  INFO: Department '{$row['name']}' status is '{$row['status']}' (not active)\n";
    }
    
    // Test 6: Non-existent department
    echo "\nTest 6: Non-existent department lookup (should fail)\n";
    $deptStmt = $db->prepare("SELECT id, name, status FROM departments WHERE name = ? LIMIT 1");
    $deptStmt->execute(['NonExistentDept']);
    $row = $deptStmt->fetch();
    if (!$row) {
        echo "  PASS: Correctly returned no result for non-existent department\n";
    } else {
        echo "  FAIL: Unexpectedly found a department\n";
    }
    
    echo "\n=== ALL TESTS COMPLETED ===\n";
    
} catch (Exception $e) {
    echo 'ERROR: ' . $e->getMessage() . "\n";
    echo "Trace: " . $e->getTraceAsString() . "\n";
}